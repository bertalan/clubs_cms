#!/usr/bin/env bash
# Gate locale: blocca il push se la CI non passa.
# Saltare (solo in emergenza): git push --no-verify
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"

# Nessun commit da inviare (es. solo cancellazione di branch remoti): niente da verificare.
has_commits=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$local_sha" =~ ^0+$ ]] || has_commits=1
done
[[ "$has_commits" == "1" ]] || exit 0

echo "pre-push: eseguo clubcms/scripts/ci.sh ..."
bash "$ROOT/clubcms/scripts/ci.sh"
